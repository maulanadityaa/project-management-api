  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CheckUsernameRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "test_username",
            "description": "Username"
          }
        },
        "required": [
          "username"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "test_username",
            "description": "Username"
          },
          "email": {
            "type": "string",
            "example": "email@example.com",
            "description": "Email"
          },
          "name": {
            "type": "string",
            "example": "test_name",
            "description": "Name"
          },
          "password": {
            "type": "string",
            "example": "test_password",
            "description": "Password"
          }
        },
        "required": [
          "username",
          "email",
          "name",
          "password"
        ]
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "validJwtToken",
            "description": "Token"
          },
          "isEmailSent": {
            "type": "boolean",
            "example": true,
            "description": "Is Email Sent"
          }
        },
        "required": [
          "token",
          "isEmailSent"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "test_username",
            "description": "Username"
          },
          "name": {
            "type": "string",
            "example": "test_name",
            "description": "Name"
          },
          "uid": {
            "type": "string",
            "example": "ValidUUIDv4",
            "description": "User ID"
          },
          "email": {
            "type": "string",
            "example": "example@mail.com",
            "description": "Email"
          }
        },
        "required": [
          "username",
          "name",
          "uid",
          "email"
        ]
      },
      "UserMailRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "username",
            "description": "Username"
          },
          "uid": {
            "type": "string",
            "example": "ValidUUIDv4",
            "description": "User ID"
          },
          "email": {
            "type": "string",
            "example": "example@email.com",
            "description": "Email (optional -- for send reset password only)"
          }
        },
        "required": [
          "username",
          "uid"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "test_username",
            "description": "Username"
          },
          "password": {
            "type": "string",
            "example": "test_password",
            "description": "Password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "validJwtToken",
            "description": "Token"
          },
          "isConfirmed": {
            "type": "boolean",
            "example": true,
            "description": "Is User Confirmed"
          }
        },
        "required": [
          "token",
          "isConfirmed"
        ]
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "validCode",
            "description": "Code"
          },
          "username": {
            "type": "string",
            "example": "test_username",
            "description": "Username"
          },
          "uid": {
            "type": "string",
            "example": "ValidUUIDv4",
            "description": "User ID"
          }
        },
        "required": [
          "code",
          "username",
          "uid"
        ]
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "example": "ValidUUIDv4",
            "description": "User ID"
          },
          "name": {
            "type": "string",
            "example": "test_name",
            "description": "Name (optional)"
          },
          "password": {
            "type": "string",
            "example": "test_password",
            "description": "Password (optional)"
          },
          "code": {
            "type": "string",
            "example": "code",
            "description": "Password reset code (optional -- for password reset only)"
          }
        },
        "required": [
          "uid"
        ]
      },
      "UserForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "example@email.com",
            "description": "Email"
          }
        },
        "required": [
          "email"
        ]
      },
      "UserForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "validJwtToken",
            "description": "Token"
          },
          "isEmailSent": {
            "type": "boolean",
            "example": true,
            "description": "Is Email Sent"
          }
        },
        "required": [
          "token",
          "isEmailSent"
