doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Email Confirmation
  body(style="margin:0; padding:0; background-color:#ffffff; font-family: Arial, sans-serif;")
    table(width="100%", cellpadding="0", cellspacing="0", border="0", role="presentation", style="background-color:#ffffff; padding:40px 20px;")
      tr
        td(align="center")
          table(width="600", cellpadding="0", cellspacing="0", border="0", role="presentation", style="background-color:#ffffff; max-width:600px; width:100%; border:1px solid #e5e7eb; border-radius:12px; text-align:center; padding:40px 30px;")
            tr
              td
                h1(style="font-size:32px; color:#111827; margin:0 0 20px 0; font-weight:normal;") Hello #{name},
                p(style="font-size:16px; color:#6b7280; margin:0 0 16px 0; line-height:1.5;") Thank you for signing up! Use the token below to confirm your email address.
                p(style="font-size:16px; color:#6b7280; margin:0 0 24px 0; line-height:1.5;") Your confirmation token is valid for 5 minutes.
                div(style="font-size:20px; font-weight:bold; color:#ffffff; background-color:#111827; padding:16px 24px; border-radius:12px; display:inline-block; margin:30px 0;")
                  | #{token}
                p(style="font-size:14px; color:#6b7280; margin:20px 0 10px 0; line-height:1.4;") If you did not create an account, please ignore this email.
          p(style="font-size:12px; color:#9ca3af; text-align:center; margin-top:32px;") &copy; #{year} Project Management. All rights reserved.
